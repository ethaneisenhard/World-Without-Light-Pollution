{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-without-light-pollution",
  "account_id": "c96f5c11e25505555d06dc79e77c6574",
  "compatibility_date": "2026-04-16",
  "main": "./src/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-without-light-pollution",
      "database_id": "62443965-cdcc-4d15-bd94-4e8f4520e94f",
      "migrations_dir": "./migrations"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "worldwithoutlightpollution.org/*",
      "zone_name": "worldwithoutlightpollution.org"
    },
    {
      "pattern": "www.worldwithoutlightpollution.org/*",
      "zone_name": "worldwithoutlightpollution.org"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://worldwithoutlightpollution.org"
  }
}
