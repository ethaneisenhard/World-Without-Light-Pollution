{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-against-light-pollution",
  "compatibility_date": "2026-04-16",
  "main": "./src/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Auth (email/password + Google + reset) is D1-backed. Run once per project:
  //   wrangler d1 create world-against-light-pollution      → paste the returned database_id below
  //   pnpm db:migrate:local                                  → apply ./migrations to local D1
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-against-light-pollution",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // When enabling MCP OAuth (createStudioMcpOAuthProvider), bind KV:
  // "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<kv-id>", "preview_id": "<preview-id>" }]
  "vars": {
    "SESSION_SECRET": "dev-only-starter-session-secret-change-me",
    // Set for Google OAuth + password reset links. Local default:
    "APP_ORIGIN": "http://127.0.0.1:8794"
  }
}
